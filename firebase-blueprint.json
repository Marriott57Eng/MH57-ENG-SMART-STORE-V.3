{
  "entities": {
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "An item in the warehouse inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "qty": { "type": "number" },
        "minStock": { "type": "number" },
        "location": { "type": "string" },
        "note": { "type": "string" },
        "ordered": { "type": "string" },
        "orderedDate": { "type": "string" },
        "status": { "type": "string", "enum": ["normal", "low", "out"] },
        "outOfStockDate": { "type": "string" }
      },
      "required": ["id", "name", "category", "unit", "qty", "minStock", "status"]
    },
    "RequisitionRecord": {
      "title": "Requisition Record",
      "description": "Log of stock in and stock out transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["in", "out"] },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "category": { "type": "string" },
        "qty": { "type": "number" },
        "unit": { "type": "string" },
        "requestedBy": { "type": "string" },
        "purpose": { "type": "string" },
        "timestamp": { "type": "string" },
        "isoDate": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["id", "itemId", "itemName", "qty", "unit", "requestedBy", "isoDate"]
    },
    "User": {
      "title": "User Account",
      "description": "User profile and authentication data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" },
        "nickname": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "username", "name", "role"]
    },
    "LineConfig": {
      "title": "LINE Notification Configuration",
      "description": "Configuration settings for LINE Messaging API",
      "type": "object",
      "properties": {
        "channelAccessToken": { "type": "string" },
        "channelSecret": { "type": "string" },
        "destinationId": { "type": "string" },
        "notifyStockOut": { "type": "boolean" },
        "notifyStockIn": { "type": "boolean" },
        "notifyLowStock": { "type": "boolean" },
        "notifyPurchaseOrder": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    },
    "PurchaseOrder": {
      "title": "Purchase Order",
      "description": "Purchase order records for restocking low or out of stock items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "category": { "type": "string" },
        "qty": { "type": "number" },
        "unit": { "type": "string" },
        "currentQty": { "type": "number" },
        "minStock": { "type": "number" },
        "location": { "type": "string" },
        "requestedBy": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "supplier": { "type": "string" },
        "note": { "type": "string" },
        "urgency": { "type": "string", "enum": ["normal", "urgent", "critical"] },
        "status": { "type": "string", "enum": ["pending", "confirmed", "received", "cancelled"] },
        "createdAt": { "type": "string" },
        "isoDate": { "type": "string" },
        "confirmedAt": { "type": "string" },
        "confirmedBy": { "type": "string" },
        "receivedAt": { "type": "string" },
        "receivedBy": { "type": "string" },
        "confirmationToken": { "type": "string" }
      },
      "required": ["id", "itemId", "itemName", "qty", "unit", "requestedBy", "status", "isoDate"]
    }
  },
  "firestore": {
    "/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Warehouse stock inventory items"
    },
    "/requisitions/{requisitionId}": {
      "schema": "RequisitionRecord",
      "description": "Transaction logs for stock requisition and receiving"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "System user profiles"
    },
    "/orders/{orderId}": {
      "schema": "PurchaseOrder",
      "description": "Purchase orders and approval workflow"
    },
    "/app_settings/{settingId}": {
      "schema": "LineConfig",
      "description": "Application settings including LINE notification configuration"
    }
  }
}
